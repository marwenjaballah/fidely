# ==============================================================================
# FIDELY DOCKER ENVIRONMENT CONFIGURATION (.env.docker.example)
# ==============================================================================

# Public URLs (resolves locally to 127.0.0.1 via browser localhost loopback)
NEXT_PUBLIC_API_URL=http://api.localhost
NEXT_PUBLIC_APP_URL=http://fidely.localhost
API_URL=http://api.localhost
WEB_URL=http://fidely.localhost

# Database (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Supabase Auth & Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Security secrets
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
COOKIE_SECRET=super_secret_cookie_key_at_least_32_characters_long
CRON_SECRET=super_secret_cron_key_at_least_32_characters_long
